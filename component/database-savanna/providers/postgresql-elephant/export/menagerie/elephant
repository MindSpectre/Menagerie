#pragma once

/**
 * Public umbrella for the savanna database component built around its PostgreSQL
 * provider. Aggregates the provider-agnostic core (features, base contracts,
 * primitives, query building) together with every public leaf header of the
 * elephant provider; consumers link Menagerie::Component::Savanna::Elephant and
 * write `#include <menagerie/elephant>`.
 */

// -- Features - provider selection -------------------------------------------
#include <providers.hpp>

// -- Base - the contracts a provider implements -------------------------------
#include <db_error_codes.hpp>
#include <db_exceptions.hpp>
#include <dialect_concepts.hpp>
#include <sql_params.hpp>
#include <sql_type_mapping.hpp>

// -- Primitives - schema and value vocabulary ----------------------------------
#include <db_core_objects.hpp>

// -- Query - expression tree and its compiler -----------------------------------
#include <compiled_query/compiled_dynamic_query.hpp>
#include <compiled_query/compiled_static_query.hpp>
#include <param_mode.hpp>
#include <query_compiler.hpp>
#include <query_expressions.hpp>
#include <query_visitor/query_visitor.hpp>
#include <query_visitor/sql_generator_visitor.hpp>

// -- Registries - OID, wire format, and SQL type tables ---------------------------
#include <postgres_format_registry.hpp>
#include <postgres_oid_type_registry.hpp>
#include <postgres_sql_type_registry.hpp>

// -- Dialect and type mapping -------------------------------------------------------
#include <postgres_dialect.hpp>
#include <postgres_type_mapping.hpp>

// -- Params, errors, results ----------------------------------------------------------
#include <postgres_errors.hpp>
#include <postgres_params.hpp>
#include <postgres_result.hpp>
#include <views/postgres_result_views.hpp>

// -- Config ------------------------------------------------------------------------------
#include <credentials/postgres_connection_credentials.hpp>
#include <postgres_connection_config.hpp>
#include <tools/postgres_connection_tools.hpp>
#include <tools/postgres_nodes_role.hpp>
#include <tools/postgres_ssl_mode.hpp>

// -- Connections and capabilities -----------------------------------------------------------
#include <capability_provider.hpp>
#include <connection.hpp>
#include <connection_holder.hpp>
#include <executor_concept.hpp>
#include <postgres_async_executor.hpp>
#include <postgres_copier.hpp>
#include <postgres_notifier.hpp>
#include <postgres_pipeline.hpp>
#include <postgres_sync_executor.hpp>
#include <process_pgresult.hpp>

// -- Session - the pooled-connection entry point ------------------------------------------------
#include <pool_config.hpp>
#include <postgres_session.hpp>

// -- Transactions ---------------------------------------------------------------------------------
#include <postgres_transaction.hpp>
#include <savepoint/savepoint.hpp>

